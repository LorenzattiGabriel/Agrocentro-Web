generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// "repuestos" and "implementos" models contain row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.


model repuestos {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  nombre      String
  ids_imagenes  String[]
  marca       String
  categoria   String

  atributos   Json? //luego se crea un type en typescript: 
                    //{label: String, detalle: String | {subLabel: String, detalle: String}}

  @@index([nombre])
  @@index([marca])
  @@index([categoria])
}

model implementos {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  
  nombre         String
  ids_imagenes   String[]
  marca          String
  modelo         String
  categoria      String

  esNuevo        Boolean
  anio           Int?

  atributos      Json? //luego se crea un type en typescript: 
                       //{label: String, detalle: String | {subLabel: String, detalle: String}}

  @@index([nombre])
  @@index([marca])
  @@index([categoria])
}
